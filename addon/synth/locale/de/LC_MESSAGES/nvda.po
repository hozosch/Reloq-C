msgid "&Add file…"
msgstr "Datei &hinzufügen…"

msgid "&Remove"
msgstr "&Entfernen"

msgid "Move &up"
msgstr "Nach &oben"

msgid "Move &down"
msgstr "Nach &unten"

msgid "Own entries override community entries. Original files are kept unchanged."
msgstr "Eigene Einträge haben Vorrang vor Community-Einträgen. Originaldateien bleiben unverändert."

msgid "&Update now"
msgstr "&Jetzt aktualisieren"

msgid "&Save own files"
msgstr "Eigene Dateien &speichern"

msgid "Close"
msgstr "Schließen"

msgid "Main words"
msgstr "Hauptwörterbuch"

msgid "Word roots"
msgstr "Wortstämme"

msgid "Abbreviations"
msgstr "Abkürzungen"

msgid "Choose a pronunciation dictionary"
msgstr "Aussprachewörterbuch auswählen"

msgid "Dictionary files (*.dic)|*.dic|All files (*.*)|*.*"
msgstr "Wörterbuchdateien (*.dic)|*.dic|Alle Dateien (*.*)|*.*"

msgid "Language of the dictionary:"
msgstr "Sprache des Wörterbuchs:"

