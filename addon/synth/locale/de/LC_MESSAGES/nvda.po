#: synthDrivers/reloqC/__init__.py
msgid "Use &community pronunciation dictionaries"
msgstr "&Gemeinschaftswörterbücher für die Aussprache verwenden"

msgid "Eloquence C pronunciation dictionaries"
msgstr "Eloquence C: Aussprachewörterbücher"

msgid "&Own dictionary files (later files take priority):"
